{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KVP Assistant Mesh",
  "version": "1.0.0",
  "identifier": "net.city.kvp.assistantmesh",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "mesh",
        "title": "KVP ASSISTANT MESH",
        "width": 1280,
        "height": 840,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": { "active": false }
}
