{
  "version": 1,
  "limits": {
    "max_ttl_seconds": 300,
    "max_past_age_seconds": 300,
    "max_future_skew_seconds": 30,
    "min_nonce_length": 16,
    "max_nonce_length": 128,
    "max_payload_bytes": 16384,
    "max_metadata_bytes": 4096,
    "max_metadata_depth": 4,
    "max_recipients": 32
  },
  "replay": {
    "max_entries": 10000
  },
  "transport": {
    "max_pending_requests": 128,
    "max_pending_responses": 128,
    "max_request_bytes": 65536,
    "max_response_bytes": 2097152
  },
  "identities": {
    "local-architect": {"role": "architect", "enabled": true},
    "local-builder": {"role": "builder", "enabled": true},
    "local-reviewer": {"role": "reviewer", "enabled": true},
    "local-security": {"role": "security", "enabled": true},
    "local-observer": {"role": "observer", "enabled": true}
  },
  "providers": {
    "mock": {"locality": "local", "enabled": true},
    "command_bus": {"locality": "local", "enabled": true},
    "external_disabled": {"locality": "external", "enabled": false}
  },
  "routes": [
    {"target_type": "model", "target_id": "mock/local-echo", "provider": "mock"},
    {"target_type": "agent", "target_id": "mock/local-echo", "provider": "mock"},
    {"target_type": "service", "target_id": "command-bus", "provider": "command_bus"}
  ],
  "communications": {
    "limits": {
      "max_conversations": 256,
      "max_messages_per_conversation": 256,
      "max_rooms": 32,
      "max_room_members": 32,
      "max_recipients": 32
    },
    "rooms": {
      "temple-build": [
        {"type": "actor", "id": "local-architect"},
        {"type": "actor", "id": "local-builder"},
        {"type": "actor", "id": "local-reviewer"}
      ]
    }
  },
  "audit": {
    "type": "jsonl",
    "path": ".local/command_bus/audit.jsonl",
    "max_entries": 10000,
    "max_event_bytes": 16384
  }
}
