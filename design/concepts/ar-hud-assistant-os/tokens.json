{
  "schema_version": 1,
  "name": "ar-hud-assistant-os",
  "description": "Seed tokens for the NetCity KVP AR HUD assistant system OS direction",
  "color": {
    "canvas.void": "#060a0f",
    "surface.base": "#0b151b",
    "surface.raised": "#0f1d23",
    "surface.focus": "#142a2a",
    "line.default": "#263e3e",
    "line.strong": "#3b6f66",
    "signal.local": "#7df6d1",
    "signal.remote": "#aab7ff",
    "signal.caution": "#f0c66e",
    "signal.danger": "#ff8893",
    "text.primary": "#e9f6f3",
    "text.muted": "#8ca19d",
    "text.dim": "#617570"
  },
  "type": {
    "display.family": "Aptos, Inter, Segoe UI, system-ui, sans-serif",
    "data.family": "Space Mono, Cascadia Code, Consolas, monospace",
    "display.weight": 650,
    "body.line_height": 1.55,
    "data.letter_spacing": "0.08em"
  },
  "motion": {
    "signal.pulse_ms": 5000,
    "orbit.duration_ms": 15000,
    "interaction.transition_ms": 180,
    "reduced_motion": "disable decorative motion; preserve state changes"
  },
  "geometry": {
    "panel.radius": "7px",
    "control.radius": "4px",
    "grid.unit": "8px",
    "focus.ring": "2px"
  }
}
